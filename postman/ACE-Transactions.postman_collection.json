{
  "info": {
    "_postman_id": "ace-transactions-collection-v1",
    "name": "ACE Digital Transactions API",
    "description": "Comprehensive Postman test collection for the ACE Digital Transaction Management System API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains status ok', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uniqueEmail = 'postman.' + Date.now() + '@example.com';",
                  "pm.environment.set('userEmail', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns user and accessToken', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('userEmail'));",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Tester\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns valid accessToken', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Invalid Credentials (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns UNAUTHORIZED error code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"WrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register Duplicate Email (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Returns EMAIL_EXISTS error code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('EMAIL_EXISTS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Duplicate User\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile (/api/users/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns user profile without passwordHash', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.email).to.eql(pm.environment.get('userEmail'));",
                  "    pm.expect(json.data.id).to.be.a('string');",
                  "    pm.expect(json.data).to.not.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Get Profile Unauthorized (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns UNAUTHORIZED error code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid-token-sample"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var idempKey = 'pm-key-' + Date.now();",
                  "pm.environment.set('idempotencyKey', idempKey);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns pending transaction with public transactionId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('PENDING');",
                  "    pm.expect(json.data.amount).to.eql('125.50');",
                  "    pm.expect(json.data.currency).to.eql('USD');",
                  "    pm.expect(json.data.transactionId).to.be.a('string');",
                  "    pm.environment.set('transactionId', json.data.transactionId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": \"125.50\",\n    \"currency\": \"USD\",\n    \"description\": \"Postman Test Transaction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Idempotent Replay (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 for idempotent replay', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns same transactionId', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.transactionId).to.eql(pm.environment.get('transactionId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": \"125.50\",\n    \"currency\": \"USD\",\n    \"description\": \"Postman Test Transaction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Idempotency Conflict (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 for payload conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Returns IDEMPOTENCY_CONFLICT code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('IDEMPOTENCY_CONFLICT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": \"999.00\",\n    \"currency\": \"USD\",\n    \"description\": \"Changed Payload\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Validation Error (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422 for invalid body', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Returns VALIDATION_ERROR code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "validation-test-key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": \"invalid\",\n    \"currency\": \"ZZZ1\",\n    \"description\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "List Transactions History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns items and pagination metadata', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.items).to.be.an('array');",
                  "    pm.expect(json.data.pagination).to.have.property('page');",
                  "    pm.expect(json.data.pagination).to.have.property('total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Transaction Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns transaction matching stored id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.transactionId).to.eql(pm.environment.get('transactionId'));",
                  "    pm.expect(json.data).to.not.have.property('idempotencyKey');",
                  "    pm.expect(json.data).to.not.have.property('userId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            }
          }
        },
        {
          "name": "Get Transaction Not Found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Returns NOT_FOUND code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/TXN-NONEXISTENT-999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "TXN-NONEXISTENT-999"]
            }
          }
        },
        {
          "name": "Simulate Transaction Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status transitions to SUCCESS with processedAt timestamp', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('SUCCESS');",
                  "    pm.expect(json.data.processedAt).to.be.a('string');",
                  "    pm.expect(json.data.failureReason).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"outcome\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}", "simulate"]
            }
          }
        },
        {
          "name": "Re-simulate Terminal Conflict (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 for terminal conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Returns CONFLICT error code', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('CONFLICT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"outcome\": \"FAILED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}", "simulate"]
            }
          }
        }
      ]
    }
  ]
}
